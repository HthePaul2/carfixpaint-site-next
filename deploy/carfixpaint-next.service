[Unit]
Description=CarFix Paint Next.js + Payload
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/tigidal/web/carfixpaint.tigidal.ro/private/site-next/.next/standalone
Environment=NODE_ENV=production
Environment=PORT=3010
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/home/tigidal/web/carfixpaint.tigidal.ro/private/site-next/.env.production
ExecStart=/root/.nvm/versions/node/v22.22.2/bin/node server.js
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
