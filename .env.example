# App
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload
PAYLOAD_SECRET=replace-with-a-long-random-secret

# PostgreSQL — alege una din variante:

# A) Homebrew Postgres local (macOS, fără Docker)
# DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/carfix

# B) Docker Compose din acest proiect
# DATABASE_URL=postgresql://carfix:carfix@localhost:5432/carfix

DATABASE_URL=postgresql://paulhosu@localhost:5432/carfix

# Email notifications — optional
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Optional S3-compatible storage (Cloudflare R2, AWS S3, etc.)
# When unset, media is stored locally in ./media
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Set to false for AWS S3; keep true (default) for R2/MinIO
S3_FORCE_PATH_STYLE=true
